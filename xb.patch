From 047eb8cde0834fc297fb8bab43168eba6773b5ab Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 08:32:50 +0600
Subject: [PATCH] artistSongs: fall back to song search when YouTube rejects
 getArtistSongs

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SyaAcDHeCcgLxcQLVpWQpF
---
 test/ytm.test.js | 21 +++++++++++++++++++++
 ytm.js           | 47 +++++++++++++++++++++++++++++++++--------------
 2 files changed, 54 insertions(+), 14 deletions(-)

diff --git a/test/ytm.test.js b/test/ytm.test.js
index 9e4c127..1896685 100644
--- a/test/ytm.test.js
+++ b/test/ytm.test.js
@@ -139,3 +139,24 @@ test('artistSongs: no exact name match means no songs (nothing invented)', async
   };
   assert.deepStrictEqual(await artistSongs(ytm, 'Ado'), []);
 });
+
+test('artistSongs: getArtistSongs fails (YouTube 400), falls back to song search by artist id', async () => {
+  const ytm = {
+    searchArtists: async () => [{ name: 'Ado', artistId: 'UC_ado' }],
+    getArtistSongs: async () => { throw new Error('Request failed with status code 400'); },
+    searchSongs: async () => [
+      hit('ado1000000a', 'Usseewa', 'Ado', 'UC_ado'),
+      hit('oth1000000b', 'Ado', 'Thud', 'UC_thud'), // title is "Ado", artist is not
+      hit('noid0000001', 'Ghost', 'Ado'), // search row without an id: not trusted
+    ],
+  };
+  assert.deepStrictEqual(ids(await artistSongs(ytm, 'Ado')), ['ado1000000a']);
+});
+
+test('artistSongs: artist search itself fails, exact artist name only', async () => {
+  const ytm = {
+    searchArtists: async () => { throw new Error('400'); },
+    searchSongs: async () => [hit('ado1000000a', 'Usseewa', 'Ado', 'UC_ado'), hit('oth1000000b', 'x', 'ADO Band', 'UC_b')],
+  };
+  assert.deepStrictEqual(ids(await artistSongs(ytm, 'Ado')), ['ado1000000a']);
+});
diff --git a/ytm.js b/ytm.js
index e517481..ecc4c06 100644
--- a/ytm.js
+++ b/ytm.js
@@ -125,22 +125,41 @@ async function similarSongs(ytm, id, q, artist = '', limit = 25) {
 // "Ado" never mixes in "ADO", "ado nakamura" or a song that merely contains "ado".
 // YouTube Music ranks the real artist first, so the first exact match is used.
 async function artistSongs(ytm, name, limit = 25) {
-  const hits = await ytm.searchArtists(name);
-  const found = hits.find((h) => norm(h.name) === norm(name));
-  if (!found?.artistId) return [];
+  // Each YouTube call can fail on its own (YouTube answers 400 / changes its format),
+  // so a failure just moves on to the next source instead of failing the whole mix.
+  let hits = null;
+  try { hits = await ytm.searchArtists(name); } catch { /* name mode below */ }
+  let found = null;
+  if (hits) {
+    found = hits.find((h) => norm(h.name) === norm(name));
+    if (!found?.artistId) return []; // artist not found by exact name: invent nothing
+  }
   const out = [];
   const seen = new Set();
-  for (const s of await ytm.getArtistSongs(found.artistId)) {
-    if (!s.videoId || !s.name || seen.has(s.videoId)) continue;
-    if (s.artist?.artistId && s.artist.artistId !== found.artistId) continue;
-    seen.add(s.videoId);
-    out.push({
-      id: s.videoId,
-      title: s.name,
-      artist: s.artist?.name || found.name,
-      duration: s.duration, // seconds, same as /search
-      thumb: `https://i.ytimg.com/vi/${s.videoId}/mqdefault.jpg`,
-    });
+  const add = (rows, fromSearch) => {
+    for (const s of rows || []) {
+      if (!s.videoId || !s.name || seen.has(s.videoId)) continue;
+      if (found) {
+        // rows with an artist id must be this artist; search rows must carry that id
+        if (s.artist?.artistId ? s.artist.artistId !== found.artistId : fromSearch) continue;
+      } else if (norm(s.artist?.name) !== norm(name)) {
+        continue; // no artist id to go by: exact artist name only
+      }
+      seen.add(s.videoId);
+      out.push({
+        id: s.videoId,
+        title: s.name,
+        artist: s.artist?.name || found?.name || name,
+        duration: s.duration, // seconds, same as /search
+        thumb: `https://i.ytimg.com/vi/${s.videoId}/mqdefault.jpg`,
+      });
+    }
+  };
+  if (found) {
+    try { add(await ytm.getArtistSongs(found.artistId), false); } catch { /* try search */ }
+  }
+  if (out.length < 10) {
+    try { add(await ytm.searchSongs(name), true); } catch { /* keep what we have */ }
   }
   return out.slice(0, limit);
 }
